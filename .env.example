# Copy this file to .env and fill in your values.
#
# NAUKRI_NKPARAM rotates with every browser session.
# How to get a fresh value:
#   1. Open naukri.com in Chrome and search for anything
#   2. Open DevTools (F12) → Network tab
#   3. Click any request to "jobapi/v3/search"
#   4. Go to Headers → Request Headers → copy the "nkparam" value

NAUKRI_NKPARAM=your_nkparam_value_here
